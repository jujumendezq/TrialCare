# ─────────────────────────────────────────────────────────────
# PinoyCare CH — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` on your machine and fill in real
# values. NEVER commit `.env.local` — it is already in `.gitignore`.
#
# For GitHub Pages builds, add these same values as repo secrets:
#   Settings → Secrets and variables → Actions → New repository secret
# ─────────────────────────────────────────────────────────────

# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only: bypasses RLS. NEVER expose to the browser.
# Only needed on hosts that run server code (Vercel, Cloudflare Pages).
# GitHub Pages cannot use this — leave it blank there.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — transactional email. Server-only. Not used on GitHub Pages.
RESEND_API_KEY=re_your_resend_key

# Public URL of the deployed site. Used for auth redirects and links.
# GitHub Pages example:  https://YOUR-USERNAME.github.io/pinoycare-ch
# Custom domain example: https://pinoycare.ch
NEXT_PUBLIC_SITE_URL=http://localhost:3000
